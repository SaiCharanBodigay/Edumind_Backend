DB_URL=jdbc:mysql://your-db-host:3306/edumind
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=3600000
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
EDUMIND_STORAGE_DIR=/data/learning-materials
EDUMIND_ASSIGNMENT_STORAGE_DIR=/data/assignment-submissions
EDUMIND_ASSIGNMENT_MAX_SUBMISSION_SIZE_BYTES=10485760
EDUMIND_SEED_ADMIN_ENABLED=false
EDUMIND_ADMIN_USERNAME=admin
EDUMIND_ADMIN_PASSWORD=replace-with-a-strong-password
